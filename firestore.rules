rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== HELPER FUNCTIONS ==========
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'raffliraffli649@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTopupNominal() {
      return request.resource.data.nominal is int
        && request.resource.data.nominal >= 2000
        && request.resource.data.nominal <= 1000000;
    }

    // ========== USERS ==========
    match /users/{userId} {
      // User bisa baca profil sendiri, admin bisa baca semua
      allow read: if isOwner(userId) || isAdmin();

      // User hanya bisa create profil sendiri saat register
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.balance == 0
        && request.resource.data.role in ['user', 'admin'];

      // User boleh update field non-sensitif + projectCount (saat buat project)
      // Balance & role hanya boleh diubah admin
      allow update: if isAdmin()
        || (isOwner(userId)
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['balance', 'role', 'uid', 'email']));

      allow delete: if isAdmin();
    }

    // ========== TEMPLATES ==========
    match /templates/{templateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ========== PROJECTS ==========
    match /projects/{projectId} {
      // Public bisa baca (untuk link publik p.html?code=XXX)
      allow read: if true;

      // User hanya boleh buat project untuk dirinya sendiri
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(['code', 'ownerId', 'templateId', 'isFree', 'maxEdits', 'editsUsed'])
        && request.resource.data.editsUsed == 0;

      // Owner boleh update (edit project), tapi tidak boleh ubah ownerId / code / maxEdits / isFree / price
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['ownerId', 'code', 'maxEdits', 'isFree', 'price']);

      // Owner atau admin boleh hapus
      allow delete: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    // ========== TOPUPS ==========
    match /topups/{topupId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'PENDING'
        && isValidTopupNominal()
        && request.resource.data.keys().hasAll(['userId', 'email', 'nominal', 'status', 'proofURL']);

      allow update: if isAdmin()
        && request.resource.data.status in ['APPROVED', 'REJECTED', 'PENDING'];

      allow delete: if isAdmin();
    }

    // ========== PURCHASES ==========
    match /purchases/{purchaseId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // ========== BALANCE HISTORY ==========
    match /balance_history/{historyId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
